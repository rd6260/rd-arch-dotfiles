#!/usr/bin/env sh

SS_DIR="$HOME/Pictures/screenshots"
FILENAME="$SS_DIR/ss_$(date +%Y%m%d_%H%M%S).png"

# ensure screenshot directory exists
mkdir -p "$SS_DIR"

# Print the name of the currently focused output (empty if unknown)
get_focused_output() {
  if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] && command -v hyprctl >/dev/null 2>&1; then
    hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'
  elif [ -n "$SWAYSOCK" ] && command -v swaymsg >/dev/null 2>&1; then
    swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name'
  elif [ -n "$NIRI_SOCKET" ] && command -v niri >/dev/null 2>&1; then
    niri msg --json focused-output | jq -r '.name'
  fi
}

# Save to file, copy to clipboard
finish() {
  [ -s "$FILENAME" ] || exit 1
  wl-copy < "$FILENAME"
  notify-send "Screenshot taken" "$FILENAME"
}

# All monitors
screenshot_all() {
  grim "$FILENAME" && finish
}

# Selected area
screenshot_selective() {
  AREA=$(slurp -w 0) || exit 0
  grim -g "$AREA" "$FILENAME" && finish
}

# Current (focused) monitor
screenshot_current() {
  OUTPUT=$(get_focused_output)
  if [ -n "$OUTPUT" ]; then
    grim -o "$OUTPUT" "$FILENAME" && finish
  else
    # couldn't detect focused monitor, fall back to all outputs
    screenshot_all
  fi
}

case "$1" in
  all)       screenshot_all ;;
  selective) screenshot_selective ;;
  current|*) screenshot_current ;;
esac
