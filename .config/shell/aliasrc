#!/bin/bash

to1080p() {
  local input="$1"
  if [[ ! -f "$input" ]]; then
    echo "Usage: to1080p <video-file>" >&2
    return 1
  fi

  local base="${input%.*}"
  local ext="${input##*.}"
  local output="${base}_1080p.${ext}"

  ffmpeg -i "$input" \
    -vf "scale=-2:1080" \
    -c:v libx264 -crf 20 -preset medium \
    -an \
    "$output"
}


ytm() {
  if [ -z "$1" ]; then
    echo "Usage: ytm <youtube-music-url> [more urls...]"
    return 1
  fi

  yt-dlp \
    -x --audio-format mp3 --audio-quality 0 \
    --embed-metadata --embed-thumbnail \
    --convert-thumbnails jpg \
    --ppa "ThumbnailsConvertor:-vf crop=min(iw\,ih):min(iw\,ih)" \
    --parse-metadata "%(artist,artists.0,uploader)s:%(meta_artist)s" \
    --parse-metadata "%(album_artist,artist,artists.0,uploader)s:%(meta_album_artist)s" \
    --parse-metadata "%(title)s:%(meta_title)s" \
    --parse-metadata "%(album,playlist_title|)s:%(meta_album)s" \
    --parse-metadata "%(release_date,upload_date)s:%(meta_date)s" \
    --parse-metadata "%(track_number,playlist_index|)s:%(meta_track)s" \
    --parse-metadata "%(genre|)s:%(meta_genre)s" \
    -o "%(artist,artists.0,uploader)s - %(title)s.%(ext)s" \
    --replace-in-metadata "meta_date" "^(\d{4})(\d{2})(\d{2})$" "\1-\2-\3" \
    "$@"
}

